# Secrets live LOCALLY only — never commit real values. Copy to your Hermes .env
# (or environment) during setup. The repo/updater never contains these.

# Dummy key so the OpenAI-style client accepts the custom provider (bridge ignores it)
OPENAI_API_KEY=sk-local-not-used

# Telegram bot token (from @BotFather) — Hermes uses it to talk to the user, and the
# updater uses it only to send the "updated to vX" note.
TELEGRAM_BOT_TOKEN=

# Optional integrations
TAVILY_API_KEY=

# Full autonomy for the agent (owner-authorized). With this on, anyone who can message
# the bot can run commands on this machine — keep the bot LOCKED to your own user id.
HERMES_YOLO_MODE=1
