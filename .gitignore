# Build artifacts
dist/
# regenerated by tools/release.py per release
manifest.json

# Updater runtime state (never distribute)
.backup/
.staging/
launcher.log
supervisor.out.log
supervisor.err.log
img_cache/
bridge.log
debug_last_request.json

# User-owned / secrets — NEVER commit
updater.config.json
.env
*.db
sessions.json
# per-machine registry of extra agents (Phase B)
agents.json
# per-machine agent state, written beside the code because the install root IS the
# code root in production - so it lands in the checkout when run from source
intercom.json
intercom/
teams.json
browser-labels.json
avatars/
# per-agent workspaces / isolated Claude config dirs
agents/
# generated fallback snippet (may contain owner id)
hermes-config-snippet.yaml
# per-machine app shortcut written by the launcher
Olivaw.vbs
*.bak
*.bak-*
*.bak.*

# Heavy/local
models/
.venv/
__pycache__/
*.pyc
node_modules/

# Security audit report (private — do not publish weaknesses of a distributed tool)
SECURITY_REVIEW.md

# SOS console conversations (local, private — transcripts of the owner's own machine)
rescue-console.jsonl
console/

# Generated while designing the icon; not part of the payload
tools/olivaw-preview.png

# The phone's door. In production the install root IS the code root, so these land here.
# remote-key.pem is this machine's whole identity to every paired phone, and devices.json
# holds the hash of every device token: neither may ever be published.
remote-cert.pem
remote-key.pem
remote-key.pem.new
remote-cert.pem.new
devices.json
pair-offer.json
relay.json

# Flutter build output
app/.dart_tool/
app/build/
app/.flutter-plugins*

# android/ IS tracked, on purpose. `flutter create` regenerates it, but it regenerates
# it WRONG for this app in three ways that each cost a build to find: no INTERNET
# permission outside the debug manifest, -Xmx8G on a machine with less free memory than
# that, and the debug signing key. Those fixes live in these files.
app/android/.gradle/
app/android/build/
app/android/app/build/
app/android/local.properties
app/android/key.properties
app/ios/

# The app signing key: whoever holds it can publish an update Android installs over
# Olivaw without a word to the person running it. It lives outside this repo entirely;
# these lines only catch a copy made by accident.
*.jks
*.keystore

# The transcriber keeps a running log beside itself.
src/stt/stt.log

# Left behind by a firebase CLI call; nothing to do with this project.
firebase-debug.log

# wrangler's own cache. It holds the Cloudflare account id and name - not a
# secret, but not this repository's business either.
# wrangler writes this wherever it is run from, so both places are named.
.wrangler/
relay/worker/.wrangler/
relay/worker/node_modules/
